# PORT KONFIGURASI SERVER
PORT=3000

# KONFIGURASI KONEKSI DATABASE MYSQL (OPSIONAL)
# Sistem secara default berjalan langsung (out-of-the-box) menggunakan penyimpanan lokal data/sman1_data.json.
# Jika ingin menghubungkan ke database MySQL lokal (XAMPP/Laragon) atau Cloud MySQL:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sman1_mapping_jurusan
